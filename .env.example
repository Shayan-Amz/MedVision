# MedVision & Clinical LLM Studio Configuration (Optimized for NVIDIA RTX 4080 12GB VRAM)
PROJECT_NAME="MedVision & Clinical LLM Studio"
ENVIRONMENT="development"

# Database & Redis
POSTGRES_USER=medvision_admin
POSTGRES_PASSWORD=medvision_secret_2026
POSTGRES_DB=medvision_db
DATABASE_URL=postgresql+asyncpg://medvision_admin:medvision_secret_2026@localhost:5432/medvision_db
REDIS_URL=redis://localhost:6379/0

# Vision Engine Configuration
VISION_BACKBONE=densenet121_xray_multilabel
VISION_INPUT_RESOLUTION=512
GRADCAM_TARGET_LAYER=features.denseblock4.denselayer16.conv2
CRITICAL_TRIAGE_THRESHOLD=0.82

# Clinical LLM & QLoRA / DPO Configuration (RTX 4080 12GB Optimized)
BASE_LLM_MODEL_ID=Qwen/Qwen2.5-7B-Instruct
LOAD_IN_4BIT=true
BNB_4BIT_COMPUTE_DTYPE=bfloat16
BNB_4BIT_QUANT_TYPE=nf4
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
DPO_BETA=0.1
AUTO_TRAIN_PAIR_THRESHOLD=25

# n8n Automation Webhooks
N8N_EMERGENCY_TRIAGE_WEBHOOK=http://localhost:5678/webhook/medvision-emergency-triage
N8N_AUTO_RETRAIN_WEBHOOK=http://localhost:5678/webhook/medvision-auto-retrain
